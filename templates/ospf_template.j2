{% if unused_interfaces is defined %}
{% for intf in unused_interfaces %}
interface {{ intf }}
 no ip address
 shutdown
!
{% endfor %}
{% endif %}
interface Loopback0
 description LAN_NETWORK
 ip address {{ lan_ip }} {{ lan_mask }}
 no shutdown
!
{% for intf in wan_interfaces %}
interface {{ intf.name }}
 description {{ intf.description }}
 ip address {{ intf.ip }} {{ intf.mask }}
 no shutdown
!
{% endfor %}
router ospf {{ ospf_process_id }}
 router-id {{ router_id }}
 passive-interface Loopback0
{% for net in ospf_networks %}
 network {{ net.ip }} {{ net.wildcard }} area {{ net.area }}
{% endfor %}
